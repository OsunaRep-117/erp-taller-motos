# Copia este archivo a .env y rellena con tu proyecto Supabase.
# NO subas .env al repositorio.

SUPABASE_URL=https://TU_PROYECTO.supabase.co
SUPABASE_ANON_KEY=tu_anon_key_aqui
GOOGLE_WEB_CLIENT_ID=tu_web_client_id.apps.googleusercontent.com

# USE_MOCK=true es el default; para Supabase usa false
USE_MOCK=false

# Android/iOS OAuth: agrega esta URL en Supabase → Authentication → Redirect URLs
# com.upfim.erpflutter://login-callback
